mp4-to-m4a() { ffmpeg -i "$1" -vn -c:a copy "${1%.*}.m4a"; }

trim-audio () {
    local in="$1" start="$2" end="$3"
    local ext="${in##*.}"
    local base="${in%.*}"
    ffmpeg -ss "$start" -to "$end" -i "$in" -c copy "${base} (trimmed).${ext}"
}

